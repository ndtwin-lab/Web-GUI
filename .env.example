# Database Configuration
DB_NAME=ndtdb
DB_USER=user
DB_PASSWORD=1234
DB_HOST=postgres
DB_PORT=5432

# NDT Server API Configuration (Required)
# Update this to point to your NDTwin server address
NDT_API_BASE_URL=http://192.168.64.8:8000

# Node Positions API Configuration (Optional)
# Default: http://localhost:3001 (for Docker) or http://localhost:3001 (for local)
VITE_NODE_POSITIONS_API_URL=http://localhost:3001

# Server Port Configuration (Optional)
# Port for the node-positions-api server
SERVER_PORT=3001

# GitHub Token (Optional)
# Required only if using LLM features that need GitHub API access
VITE_GITHUB_TOKEN=your_token_here